# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/eventful_db?schema=public

# Redis (local or Render Redis URL)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_change_in_production

# Paystack (use sk_test_ for secret, pk_test_ for public key on frontend)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# Resend email (custom domain on Cloudflare)
RESEND_API_KEY=re_your_resend_api_key
MAIL_DOMAIN=youreventful.org
MAIL_FROM_NAME=Eventful
# Optional overrides (defaults use MAIL_DOMAIN)
# MAIL_FROM_TRANSACTIONAL=no-reply@youreventful.org
# MAIL_FROM_SUPPORT=support@youreventful.org
# MAIL_FROM_NEWSLETTER=newsletter@youreventful.org
# MAIL_FROM_PERSONAL=emmanuel@youreventful.org
MAIL_REPLY_TO=support@youreventful.org
# Legacy fallback if MAIL_DOMAIN is unset
MAIL_FROM=Eventful <onboarding@yourdomain.com>

# Google OAuth (same client ID used on frontend as VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Seed script (optional — creator account password for db seed)
SEED_CREATOR_PASSWORD=your_seed_password
